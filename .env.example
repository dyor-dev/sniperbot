# ============================================================
#  Comment Sniper - konfiguratsiya namunasi
#  Nusxa oling:  cp .env.example .env   &&   chmod 600 .env
#  HECH QACHON .env faylini git'ga yoki chatga qo'ymang!
# ============================================================

# my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Sizda mavjud session string (1B... ko'rinishida). Bo'lsa shu ishlatiladi.
TELEGRAM_SESSION=

# Session string bo'lmasa, shu fayl yaratiladi (scripts/login.py bilan)
SESSION_FILE=/opt/comment-sniper/sniper.session

# Holat fayli: kanallar + komment matnlari shu yerda saqlanadi
STATE_FILE=/opt/comment-sniper/state.json

# Standart komment matnlari (| bilan ajratiladi). Keyin .word bilan o'zgartirasiz.
WORDS=Salom!|

# Bitta kanalga ketma-ket kommentlar orasidagi minimal soniya (0 = cheklovsiz)
MIN_INTERVAL=0

# Global limit: daqiqada maksimal komment (0 = cheklovsiz)
MAX_PER_MINUTE=20

# .add buyrug'i kanal/guruhga avtomatik qo'shilsinmi (yangilanish olish uchun shart)
AUTO_JOIN=1

# Havola preview'ini server tomonda generatsiya qilmaslik = tezroq yuborish
NO_WEBPAGE=1

# Buyruqlar faqat "Saved Messages"da ishlaydi. Qo'shimcha chat id'lari (vergul bilan)
COMMAND_CHAT_IDS=

# Szhetlar bo'yicha log darajasi: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# GC'ni to'liq o'chirish (0.1ms'lik pauzalarni yo'q qiladi, xotira sekin o'sadi)
GC_DISABLE=0
